---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  extraSchema?: Record<string, unknown>[];
}

const {
  title = "icracontractor.com — Premium ICRA Contractor .com Domain for Sale",
  description = "Acquire icracontractor.com — the exact-match .com for ICRA contractors. Listed at $15,000 with escrow-protected transfer for healthcare construction firms.",
  image = "https://imagedelivery.net/-sPAUAWeA405NiWJ0SNIQA/ccb64e0e-1b98-4243-8d2d-d111a277bb00/public",
  noindex = false,
  extraSchema = [],
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://icracontractor.com';
const canonicalURL = new URL(Astro.url.pathname, `${siteUrl}/`).href;
const siteName = 'ICRA Contractor';
const imageAlt = 'icracontractor.com — premium .com domain for the ICRA contractor';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: siteName,
      description,
      inLanguage: 'en-US',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description,
      isPartOf: { '@id': `${siteUrl}/#website` },
      inLanguage: 'en-US',
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: image,
        caption: imageAlt,
      },
    },
    {
      '@type': 'Product',
      name: 'icracontractor.com — Premium Domain Name',
      description: 'The direct, authoritative .com domain for ICRA-specialized healthcare construction contractors. Category-defining digital real estate for the infection control construction niche.',
      url: `${siteUrl}/`,
      image,
      category: 'Domain Names',
      brand: {
        '@type': 'Brand',
        name: siteName,
      },
      offers: {
        '@type': 'Offer',
        url: canonicalURL,
        availability: 'https://schema.org/InStock',
        priceCurrency: 'USD',
        price: '15000.00',
        itemCondition: 'https://schema.org/NewCondition',
        seller: {
          '@type': 'Organization',
          name: 'Desert Rich',
          email: 'sales@desertrich.com',
        },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          applicableCountry: 'US',
          returnPolicyCategory: 'https://schema.org/MerchantReturnNotPermitted',
          merchantReturnDays: 0,
          name: 'No Returns',
          description: 'Due to the nature of digital domain name assets, returns are not applicable after transfer.',
        },
        shippingDetails: {
          '@type': 'OfferShippingDetails',
          shippingRate: {
            '@type': 'MonetaryAmount',
            value: 0,
            currency: 'USD',
          },
          deliveryTime: {
            '@type': 'ShippingDeliveryTime',
            handlingTime: {
              '@type': 'QuantitativeValue',
              minValue: 1,
              maxValue: 5,
              unitCode: 'DAY',
            },
            transitTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 0,
              unitCode: 'DAY',
            },
          },
          shippingDestination: {
            '@type': 'DefinedRegion',
            addressCountry: 'US',
          },
        },
      },
    },
    ...extraSchema,
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Google Site Verification -->
  <meta name="google-site-verification" content="qhIxFwj48GBKOmxH4y2ik5q2dF5rtwg2rFYtSwLkEkw" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Indexing -->
  <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
  <meta name="theme-color" content="#0D9488" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:image:alt" content={imageAlt} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body class="bg-icra-surface text-slate-900 font-sans antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60] focus:bg-white focus:text-icra-deep focus:px-4 focus:py-2 focus:rounded-full focus:shadow-lg focus:font-semibold focus:text-sm">
    Skip to content
  </a>
  <slot />
</body>
</html>
